{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arvine-labs:expenses:trip-reimbursement-manifest:2.0.0",
  "title": "Arvine trip reimbursement manifest record",
  "description": "One NDJSON record exchanged from nlp-expenses to arvine-accounting-expenses.",
  "oneOf": [
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/tripReport"
    }
  ],
  "$defs": {
    "claimProgram": {
      "type": "string",
      "enum": [
        "arvine_only",
        "ivado_sponsored"
      ]
    },
    "paidBy": {
      "type": "string",
      "enum": [
        "employee_personal",
        "arvine_corporate_bmo"
      ]
    },
    "legalEntity": {
      "type": "object",
      "required": [
        "legal_name"
      ],
      "properties": {
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "lineItem": {
      "type": "object",
      "required": [
        "line_id",
        "description",
        "amount",
        "included_in_arvine",
        "included_in_ivado"
      ],
      "properties": {
        "line_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "description": "Signed line amount; promotions, discounts and credits are negative."
        },
        "is_alcohol": {
          "type": "boolean",
          "default": false
        },
        "included_in_arvine": {
          "type": "boolean"
        },
        "included_in_ivado": {
          "type": "boolean"
        },
        "ivado_exclusion_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "alcohol",
            "non_business",
            "policy_cap",
            "missing_documentation",
            "other",
            null
          ]
        },
        "review_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "settlementLeg": {
      "type": "object",
      "required": [
        "leg_id",
        "leg_type",
        "payer",
        "payee",
        "amount_cad",
        "status"
      ],
      "properties": {
        "leg_id": {
          "type": "string",
          "minLength": 1
        },
        "leg_type": {
          "type": "string",
          "enum": [
            "employee_reimbursement",
            "sponsor_reimbursement"
          ]
        },
        "payer": {
          "$ref": "#/$defs/legalEntity"
        },
        "payee": {
          "$ref": "#/$defs/legalEntity"
        },
        "amount_cad": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "approved",
            "paid",
            "reconciled"
          ]
        },
        "payment_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "payment_reference": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "accountingSummary": {
      "type": "object",
      "required": [
        "travel_non_meal_cad",
        "meal_deductible_cad",
        "meal_non_deductible_cad",
        "gst_receivable_cad",
        "qst_receivable_cad"
      ],
      "properties": {
        "travel_non_meal_cad": {
          "type": "number"
        },
        "meal_deductible_cad": {
          "type": "number"
        },
        "meal_non_deductible_cad": {
          "type": "number"
        },
        "gst_receivable_cad": {
          "type": "number"
        },
        "qst_receivable_cad": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "required": [
        "contract_version",
        "kind",
        "id",
        "trip_id",
        "parent_report_id",
        "claim_program",
        "document_date",
        "vendor",
        "currency",
        "total",
        "total_cad",
        "paid_by",
        "arvine_reimbursable_cad",
        "ivado_claimable_cad",
        "ivado_excluded_cad",
        "source_url"
      ],
      "properties": {
        "contract_version": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "receipt"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trip_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_report_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_program": {
          "$ref": "#/$defs/claimProgram"
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "subtotal": {
          "type": [
            "number",
            "null"
          ]
        },
        "gst": {
          "type": [
            "number",
            "null"
          ]
        },
        "qst": {
          "type": [
            "number",
            "null"
          ]
        },
        "other_tax": {
          "type": [
            "number",
            "null"
          ]
        },
        "tip": {
          "type": [
            "number",
            "null"
          ]
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "total_cad": {
          "type": "number",
          "minimum": 0
        },
        "paid_by": {
          "$ref": "#/$defs/paidBy"
        },
        "arvine_reimbursable_cad": {
          "type": "number",
          "minimum": 0
        },
        "ivado_claimable_cad": {
          "type": "number",
          "minimum": 0
        },
        "ivado_excluded_cad": {
          "type": "number",
          "minimum": 0
        },
        "line_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineItem"
          }
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "expense_type": {
          "type": "string"
        },
        "business_purpose": {
          "type": "string"
        },
        "attendees": {
          "type": "string"
        },
        "gst_number": {
          "type": "string"
        },
        "qst_number": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "tripReport": {
      "type": "object",
      "required": [
        "contract_version",
        "kind",
        "report_id",
        "trip_id",
        "report_date",
        "claim_program",
        "description",
        "employee",
        "company",
        "employee_reimbursement_total_cad",
        "corporate_paid_total_cad",
        "ivado_claim_total_cad",
        "ivado_excluded_total_cad",
        "accounting_summary",
        "settlement_legs",
        "source_url"
      ],
      "properties": {
        "contract_version": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "trip_report"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "trip_id": {
          "type": "string",
          "minLength": 1
        },
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "claim_program": {
          "$ref": "#/$defs/claimProgram"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "employee": {
          "$ref": "#/$defs/legalEntity"
        },
        "company": {
          "$ref": "#/$defs/legalEntity"
        },
        "sponsor": {
          "oneOf": [
            {
              "$ref": "#/$defs/legalEntity"
            },
            {
              "type": "null"
            }
          ]
        },
        "employee_reimbursement_total_cad": {
          "type": "number",
          "minimum": 0
        },
        "corporate_paid_total_cad": {
          "type": "number",
          "minimum": 0
        },
        "ivado_claim_total_cad": {
          "type": "number",
          "minimum": 0
        },
        "ivado_excluded_total_cad": {
          "type": "number",
          "minimum": 0
        },
        "accounting_summary": {
          "$ref": "#/$defs/accountingSummary"
        },
        "settlement_legs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/settlementLeg"
          }
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "ivado_template_version": {
          "type": "string"
        },
        "reimbursement_total_cad": {
          "type": "number",
          "minimum": 0,
          "deprecated": true,
          "description": "Legacy alias for employee_reimbursement_total_cad."
        }
      },
      "additionalProperties": true
    }
  }
}
